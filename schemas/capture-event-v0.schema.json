{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traceforge:schema:capture-event:0.2.0",
  "title": "TraceForge Capture Event v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "capture_id",
    "sequence",
    "event_type",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "event_id": { "$ref": "#/$defs/id" },
    "capture_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "capture_started",
        "dependency_recorded",
        "observation_recorded",
        "capture_completed",
        "capture_failed"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "payload": { "$ref": "#/$defs/jsonValue" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
